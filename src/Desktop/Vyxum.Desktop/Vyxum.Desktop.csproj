<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Lets the project restore and build on Linux CI; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Vyxum</AssemblyName>
    <RootNamespace>Vyxum.Desktop</RootNamespace>
    <ApplicationIcon>vyxum.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- BSD-3-Clause, compatible with Apache-2.0 redistribution. -->
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <!-- The WebView2 package also references its WPF assembly, which conflicts with WindowsBase (MSB3277). This project is WinForms only. -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences;FindReferenceAssembliesForReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
