<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Persistence (EF Core 10 line) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />

    <!-- Transitive pin (MIT): Microsoft.Data.SqlClient 6.1.x brings 9.0.11, which has known vulnerabilities -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />

    <!-- Serial port access (MIT, part of .NET) -->
    <PackageVersion Include="System.IO.Ports" Version="10.0.14" />

    <!-- SignalR client (MIT, part of ASP.NET Core): Agent connection to the web, integration tests -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />

    <!-- Windows service hosting (MIT, part of .NET): Vyxum.Agent runs as a service; no effect on other systems -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />

    <!-- ASP.NET Core test host (10.x line) -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />

    <!-- Tests (xUnit v3) -->
    
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />

    <!-- Architecture tests (MIT) -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

</Project>
